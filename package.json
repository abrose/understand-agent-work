{
  "name": "depgraph",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "kuzu"
    ]
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @depgraph/core run build",
    "build:server": "pnpm --filter @depgraph/server run build",
    "build:ui": "pnpm --filter @depgraph/ui run build",
    "dev:ui": "pnpm --filter @depgraph/ui run dev"
  }
}
